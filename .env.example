# ─── feling. Sourcing Agent — Environment Config ───────────────────────────

# 1. Create a Telegram bot via @BotFather and paste the token here
TELEGRAM_TOKEN=your_bot_token_here

# 2. Your personal Telegram chat ID
#    Find it by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_chat_id_here

# 3. How often to scan (in minutes). 30 is a good default.
#    Lower = more real-time but more aggressive scraping
POLL_INTERVAL_MINUTES=30

# ─── Weekly approved cost report (email) ───────────────────────────────────
# Reports also land in Telegram + reports/*.html even if email is unset.
REPORT_EMAIL=you@example.com
REPORT_FROM=feling@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# Gmail: use an App Password (Google Account → Security → App passwords)
SMTP_PASSWORD=your_app_password_here
# Cron: mon..sun, hour in local timezone
WEEKLY_REPORT_DAY=mon
WEEKLY_REPORT_HOUR=9

# ─── Weekly procurement export (Excel, newly approved only) ────────────────
# Every Friday, newly approved items (since the last export) are compiled into
# an .xlsx with brand / item / platform / price / source link / condition, etc.
# Emailed to REPORT_EMAIL (same SMTP_* creds above) and sent to Telegram.
# File also always saved under reports/*.xlsx even if email is unset.
PROCUREMENT_EXPORT_DAY=fri
PROCUREMENT_EXPORT_HOUR=9

# ─── Team web login (/ops and /review pages) ────────────────────────────────
# The bot serves a small login-gated API on this port for the internal web app
# (approve/skip queue + post-purchase tracker). Create accounts with:
#   python agent.py --add-user
# On a host with no interactive shell (e.g. Railway), set these two instead,
# deploy once, then you can remove them — safe to leave in place either way:
#   BOOTSTRAP_USER=you
#   BOOTSTRAP_PASSWORD=a-real-password
WEB_PORT=8787

# ─── Persistent storage ──────────────────────────────────────────────────────
# Where approved.json, pending.json, team_users.json etc. actually live. Leave
# unset for local dev (uses the repo checkout, same as always). On a host that
# redeploys from git on every push (Railway, etc.), point this at a mounted
# volume so state survives redeploys — e.g. Railway: attach a volume at /data
# and set DATA_DIR=/data. First boot auto-copies any matching files already
# committed to git into the new location.
DATA_DIR=/data
